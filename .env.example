# Supabase (proyecto donde corre la migración 001_dialbrain.sql)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Webhook del flow "RingFlow - Call" en Dapta (URL limpia, sin query)
DAPTA_WEBHOOK_URL=https://api.dapta.ai/api/f49523b65ffe8745/ringflow---call
# API key del flow — va como header x-api-key (el mismo valor que usas en n8n)
DAPTA_FLOW_API_KEY=REEMPLAZAR

# Número Twilio exclusivo para transfer calls (a donde Dapta transfiere)
TRANSFER_NUMBER=+17864814054

# Ritmo: cuántos intentos vencidos se despachan por tick del cron
DIALS_PER_TICK=1

# Secretos propios (inventa valores largos y aleatorios)
CRON_SECRET=
LEADS_API_KEY=
WEBHOOK_TOKEN=
